# DeepSeek API 配置
# 1. 复制本文件为 .env：  copy .env.example .env
# 2. 将下方 sk-your-key-here 替换为你的 DeepSeek API Key
# 3. 重启后端： uvicorn app.main:app --reload --port 8000

DEEPSEEK_API_KEY=sk-your-key-here

# 以下一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推荐 deepseek-chat（总结/问答）；deepseek-v4-pro 为思考模型，更慢且易因 token 不足返回空正文
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 认证与数据库
# ---------------------------------------------------------------------------
# 生产环境务必更换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168
APP_BASE_URL=http://localhost:5173
DATABASE_PATH=./data/veloclip.db

# 开发模式：验证码/魔法链接打印到后端控制台（无需 SMTP）
DEV_EMAIL_LOG=true

# 生产可选 SMTP（配置后 DEV_EMAIL_LOG 仍可保留作备份日志）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# Stripe 支付（Test mode）
# 1. Dashboard → Developers → API keys 获取 sk_test_...
# 2. Product catalog 创建 Pro 月订、旗舰一次性 Price，复制 price_...
# 3. 本地 Webhook：stripe listen --forward-to localhost:8000/api/billing/webhook
#    将输出的 whsec_... 填入 STRIPE_WEBHOOK_SECRET
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_ULTIMATE_ONETIME=price_ultimate_onetime_id
# cny 或 usd（若账号不支持 CNY 则改为 usd，前端会显示结算说明）
STRIPE_CURRENCY=cny
